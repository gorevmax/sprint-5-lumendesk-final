  {
   "fragment_id": "09-020",
   "doc_no": 9,
   "doc_id": "privacy-requests",
   "doc_version": "2026-09-01",
   "source_path": "documents/Клиентский сервис/Privacy/Обращения о данных.pdf",
   "source_sha256": "1dbcdf2c96b843fbca9156d48cf2cab3fa1581adde0428ac12da92278aaef86d",
   "source_lang": "ru",
