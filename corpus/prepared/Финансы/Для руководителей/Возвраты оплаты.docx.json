   {
    "fragment_id": "45-022",
    "doc_no": 45,
    "doc_id": "refund-approval",
    "doc_version": "2026-09-01",
    "source_path": "documents/Финансы/Для руководителей/Возвраты оплаты.docx",
    "source_sha256": "d42809880a4a58c6470d83e783200f515ce003aef83c69970b212c9891c1363a",
    "source_lang": "ru",
    "format": "docx",
    "kind": "para",
    "locator": {
     "paragraph": 22,
     "style": "Normal"
    },
    "locator_text": "абзац 22 (w:p, стиль Normal)",
    "segment_sha": "66a1706ea029",
    "section": "Передача в платёжную команду",
    "section_ru": "Передача в платёжную команду",
    "text_ru": "После согласования платёжная команда инициирует возврат в течение пяти рабочих дней. Этот срок не равен сроку поступления денег на банковский счёт клиента. Передавая статус, называйте фактическое действие и известное состояние, а не обещайте завершённое зачисление по внутренней отметке отправки. Клиент получает refund ID и ожидаемый срок банка. Внутренний маршрут согласований, фамилии согласующих и лимиты подразделений клиенту не сообщают.",
    "translation": "original_ru",
    "quarantine": false,
    "status": "include",
    "access": [
     "support_lead"
    ],
    "trust": "confirmed",
    "dup_group": null,
    "conflict_group": null
   },
   {
    "fragment_id": "45-023",
    "doc_no": 45,
    "doc_id": "refund-approval",
    "doc_version": "2026-09-01",
    "source_path": "documents/Финансы/Для руководителей/Возвраты оплаты.docx",
    "source_sha256": "d42809880a4a58c6470d83e783200f515ce003aef83c69970b212c9891c1363a",
    "source_lang": "ru",
    "format": "docx",
    "kind": "para",
    "locator": {
     "paragraph": 23,
     "style": "Normal"
    },
    "locator_text": "абзац 23 (w:p, стиль Normal)",
    "segment_sha": "3c87836867ba",
    "section": "Передача в платёжную команду",
    "section_ru": "Передача в платёжную команду",
    "text_ru": "Для проверки на планёрке рассмотрели два случая: повторное обращение по уже созданному refund ID и частичный возврат при сохранении прежнего тарифа. В первом объединили историю и не создали дубликат платёжного действия. Во втором явно отделили возврат суммы от дальнейшей коммерческой заявки. Перед закрытием руководитель проверил связность платежа, согласования и refund ID, а также убедился, что в клиентском ответе не осталось выдержек из внутренней процедуры.",
    "translation": "original_ru",
    "quarantine": false,
    "status": "include",
    "access": [
     "support_lead"
    ],
    "trust": "confirmed",
    "dup_group": null,
    "conflict_group": null
   }
  ]
