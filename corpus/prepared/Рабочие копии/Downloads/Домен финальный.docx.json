   {
    "fragment_id": "34-022",
    "doc_no": 34,
    "doc_id": "domain-verification",
    "doc_version": "2026-09-01",
    "source_path": "documents/Рабочие копии/Downloads/Домен финальный.docx",
    "source_sha256": "7331f6d1f9c357a2823f8cf4265cea4911e203261f0f129f83f0128ba9fa5c9b",
    "source_lang": "ru",
    "format": "docx",
